{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/register-agent", "dest": "/api/register_agent.py" },
    { "src": "/api/agents", "dest": "/api/agents.py" },
    { "src": "/api/discover", "dest": "/api/discover.py" },
    { "src": "/api/run-simulation", "dest": "/api/run_simulation.py" },
    { "src": "/api/reset", "dest": "/api/reset.py" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}

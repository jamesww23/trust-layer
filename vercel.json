{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=120, stale-while-revalidate=300" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/register-agent", "dest": "/api/register_agent.py" },
    { "src": "/api/agents", "dest": "/api/agents.py" },
    { "src": "/api/discover", "dest": "/api/discover.py" },
    { "src": "/api/run-simulation", "dest": "/api/run_simulation.py" },
    { "src": "/api/submit-feedback", "dest": "/api/submit_feedback.py" },
    { "src": "/api/delegate-task", "dest": "/api/delegate_task.py" },
    { "src": "/api/tasks", "dest": "/api/tasks.py" },
    { "src": "/api/submit-result", "dest": "/api/submit_result.py" },
    { "src": "/api/activity", "dest": "/api/activity.py" },
    { "src": "/api/reset", "dest": "/api/reset.py" },
    { "src": "/api/vouch", "dest": "/api/vouch.py" },
    { "src": "/api/migrate-ratings", "dest": "/api/migrate_ratings.py" },
    { "src": "/api/experiment2", "dest": "/api/experiment2.py" },
    { "src": "/api/experiment3", "dest": "/api/experiment3.py" },
    { "src": "/api/export", "dest": "/api/export_reputation.py" },
    { "src": "/api/import", "dest": "/api/import_reputation.py" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
